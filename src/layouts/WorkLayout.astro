---
// Shared shell for the portfolio pages (home, /experience, /built). Reuses the site's dark theme from global.css.
import '../styles/global.css';
import '../styles/work.css';
import { EMAIL, socials } from '../data/work.js';

const { title, description } = Astro.props;
const SITE = 'https://vandanaagarwal.in';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE}${Astro.url.pathname}`} />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${SITE}${Astro.url.pathname}`} />
  <meta property="og:image" content={`${SITE}/assets/va-portrait.jpg`} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="aurora" aria-hidden="true">
    <span class="rb r1"></span>
    <span class="rb r2"></span>
    <span class="rb r4"></span>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <header class="nav" id="siteNav">
    <div class="wrap nav-inner">
      <a href="/" class="logo">
        <img src="/assets/va-headshot.jpg" alt="" width="36" height="36" aria-hidden="true" />
        <span>Vandana Agarwal Nik</span>
      </a>
      <nav class="nav-links" id="navLinks" aria-label="Primary">
        <a href="/experience">Experience</a>
        <a href="/built">Things I built</a>
        <a href="/#recommendations">Recommendations</a>
        <a href="/coaching">Coaching</a>
        <a href="/resources">Resources</a>
      </nav>
      <a href={`mailto:${EMAIL}`} class="btn btn-primary nav-cta">Email me</a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span></span>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="w-foot">
    <div class="wrap">
      <span>Vandana Agarwal Nik · Bengaluru · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></span>
      <nav aria-label="Elsewhere">
        {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </nav>
    </div>
  </footer>

  <script>
    // Mobile menu, same behaviour as the home page
    const toggle = document.getElementById('navToggle');
    const links = document.getElementById('navLinks');
    if (toggle && links) {
      toggle.addEventListener('click', () => {
        const open = links.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      links.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => links.classList.remove('open')));
    }
    const nav = document.getElementById('siteNav');
    const onScroll = () => nav && nav.classList.toggle('scrolled', window.scrollY > 10);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</body>
</html>
