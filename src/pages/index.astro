---
import '../styles/global.css';

const TOPMATE = 'https://topmate.io/vandana_agarwal';
const EMAIL = 'coaching@vandanaagarwal.in';
const LINKEDIN = 'https://www.linkedin.com/in/meet-vandana/';
const APAC = 'https://www.linkedin.com/company/sdr-leaders-of-apac/';
const SITE = 'https://vandanaagarwal.in';
const OG_IMAGE = `${SITE}/assets/va-portrait.jpg`;

// Structured data (JSON-LD) so search engines understand the person, site, and service.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE}/#vandana`,
      name: 'Vandana Agarwal Nik',
      url: SITE,
      image: OG_IMAGE,
      jobTitle: 'SDR Coach & Sales Development Leader',
      description: 'Global SDR coach who builds and scales BDR teams from zero to pipeline across APAC, EMEA, and AMER for SaaS, identity, and cybersecurity companies.',
      sameAs: [LINKEDIN, TOPMATE, APAC],
      knowsAbout: ['Sales Development', 'SDR coaching', 'Outbound sales', 'BDR enablement', 'SaaS sales', 'Go-to-market'],
      award: '100 Powerful Women in Sales, 2025',
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'Vandana Agarwal Nik | Global SDR Coach',
      publisher: { '@id': `${SITE}/#vandana` },
      inLanguage: 'en',
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#service`,
      name: 'Vandana Agarwal Nik, SDR Coaching',
      url: SITE,
      image: OG_IMAGE,
      description: '1:1 SDR coaching, mock interviews, career clarity, and outbound consulting for founders and sales leaders. Booked on Topmate.',
      provider: { '@id': `${SITE}/#vandana` },
      areaServed: ['APAC', 'EMEA', 'AMER'],
      serviceType: 'SDR coaching and sales development consulting',
      email: EMAIL,
    },
  ],
};

// Who she helps (4 audiences) - led with the pain, then the outcome
const audiences = [
  { icon: 'ramp', title: 'New & ramping SDRs', pain: 'Busy all day, but the meetings still aren’t coming?', body: 'Your first 30, 60, 90 days, sorted. We turn activity into conversations, and conversations into booked meetings.' },
  { icon: 'door', title: 'Breaking into SaaS', pain: 'Sure you’d be great in sales, but no one calls back?', body: 'Positioning, outreach, and interview prep that actually gets you hired as an SDR.' },
  { icon: 'build', title: 'Founders & SDR leaders', pain: 'Hired SDRs, but the pipeline still isn’t predictable?', body: 'Build or fix the SDR engine: onboarding, process, outbound systems, and GTM alignment.' },
  { icon: 'compass', title: 'Feeling stuck', pain: 'Plateaued, and the next move just isn’t obvious?', body: 'An honest read on where you are, a clear next move, and a plan you actually follow.' },
];

// Stroke line-icons for the audience cards (inherit the lavender accent via currentColor)
const ICONS = {
  ramp: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M17 7h4v4"/></svg>`,
  door: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>`,
  build: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/></svg>`,
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5 5-2z"/></svg>`,
};

// ALL live Topmate services, grouped. No prices on the site, booking happens on Topmate.
const services = {
  Sessions: [
    { id: '69117', title: "Let's connect", format: '1:1 call', dur: '15 min', desc: 'A quick, no-pressure intro. Not sure which session you need? Start here and we find your next step together.', badge: 'Start here' },
    { id: '2131890', title: 'SDR Ramp Coaching', format: '1:1 call', dur: '30 min', desc: 'For new SDRs who want to start booking meetings. A weekly ramp plan, messaging and cadence fixes, and live call coaching.', badge: 'Most booked' },
    { id: '2131934', title: 'Break into SDR', format: '1:1 call', dur: '45 min', desc: 'For people entering SaaS sales. Target the right roles, position your resume and LinkedIn, and outreach that gets replies.', badge: null },
    { id: '69119', title: 'SDR Mock Interview', format: '1:1 call', dur: '45 min', desc: 'A realistic SDR interview run with honest, specific feedback. Walk in calmer and sharper for the real thing.', badge: null },
    { id: '69118', title: 'Career Clarity Call', format: '1:1 call', dur: '30 min', desc: 'A focused session to unblock your next move, whether that is AE, SDR leadership, a switch, or staying relevant as the role changes.', badge: null },
    { id: '2131970', title: 'Resume & LinkedIn Review', format: 'Async', dur: 'reply in 7 days', desc: 'No call needed. Send me your resume and LinkedIn, and I send back specific, honest written feedback to position you for SDR roles.', badge: 'No call' },
    { id: '2131945', title: 'Consulting for Founders & Leaders', format: '1:1 call', dur: '60 min', desc: 'We diagnose what is leaking in your pipeline and design the fix: process, onboarding, outbound systems, and the metrics that matter.', badge: 'For teams', wide: true },
  ],
  Packages: [
    { id: '2131963', title: 'SDR Ramp Pack', format: '3 sessions', dur: 'over 8 weeks', desc: 'Three ramp sessions across your ramp. We set the plan, review your real calls and messaging, and course-correct as your numbers move.', badge: null },
    { id: '2132282', title: '1:1 Mentorship Program', format: '6 to 8 weeks', dur: 'weekly 1:1s', desc: 'Sustained mentorship over 6 to 8 weeks. A clear roadmap, weekly sessions with real feedback, and support between sessions so you never stall.', badge: null },
    { id: '2132024', title: 'SDR Engine Build', format: 'For teams', dur: 'multi-session', desc: 'For founders and leaders. We build or rebuild your SDR engine end to end: audit, playbook, metrics, and coaching that sticks.', badge: null },
  ],
};
const groups = Object.keys(services);

const steps = [
  { n: '01', title: 'Diagnose', body: 'Session one, we pull apart your real calls, emails, and pipeline to find the actual leak. You leave knowing exactly what is costing you meetings, no guesswork.' },
  { n: '02', title: 'Playbook', body: 'We build your operating system together: ICP, cadences, call openers, and a daily rhythm you can run on a busy Monday. You walk away with the scripts, not theory.' },
  { n: '03', title: 'Coach & iterate', body: 'Then we run it. I listen to your real calls, mark the moments that win or lose the meeting, and we fix them one at a time until the numbers move.' },
];

const videos = [
  { id: 'wDsukLjubus', caption: 'Inside the SDR career in SaaS: growth and salary' },
  { id: '35mHdwO_PsI', caption: 'SDR leadership gaps in India, on the Saaspire Podcast' },
  { id: 'b5bccZRw7YU', caption: 'The SDR Leaders Playbook' },
];

const results = [
  { stat: '57% → 91%', label: 'NA inbound SAL conversion, in 5 months' },
  { stat: '0% → 105%', label: 'New SDR team to outbound target, in 4 months' },
  { stat: '17% → 49%', label: 'APAC outbound SQL-to-S1, in one quarter' },
  { stat: '2x SQLs', label: 'Outbound built from scratch at Clickpost' },
];

const testimonials = [
  { quote: 'She was very open about what I needed to improve and what my strengths were, so I could pitch myself better. Anyone breaking into SaaS should get a session with Vandana.', who: 'Bharath S', initials: 'BS' },
  { quote: 'The absolute observer who will give excellent mentorship. I got clarity about where I am and what I need to do. Thanks, Vandana.', who: 'Shivam Pandey', initials: 'SP' },
  { quote: 'The demo interview was very helpful. The pattern was so similar to the real thing that it felt like the interviewer had consulted Vandana. I highly recommend it.', who: 'Udit Sharma', initials: 'US' },
  { quote: 'I reached out to Vandana for insights on SDR hiring. She was super helpful and gave good, actionable insights.', who: 'Sandeep Gupta', initials: 'SG' },
  { quote: 'Vandana guided me with a practical path to move forward in SaaS, and her insights were both eye-opening and immensely helpful.', who: 'SDR, via Topmate', initials: 'SD' },
  { quote: 'She gave me good insights and clarity on the things I was stuck on.', who: 'Mohit Dhanwani', initials: 'MD' },
];

const faqs = [
  { q: 'Is coaching worth it at my stage?', a: 'If you are doing the work and the meetings still are not coming, a focused session usually pays for itself fast. We fix the specific thing holding you back instead of guessing for weeks. If it is not the right fit, I will tell you on the intro call.', open: true },
  { q: 'I am not sure I am ready for coaching.', a: 'You do not need it all figured out first. Most people arrive stuck or unsure, that is the whole point. Start with a short Let’s connect call, we find where you are, and you decide if going further makes sense. No pressure either way.', open: false },
  { q: 'Will you get my market if I am not in APAC?', a: 'Yes. I have built and scaled SDR teams across APAC, EMEA, and AMER, for SaaS, identity, and cybersecurity companies. The fundamentals of booking meetings travel, and I tailor the playbook to your region and motion.', open: false },
  { q: 'How do I pick the right session?', a: 'If you are unsure, start with Let’s connect and we choose together. New SDRs usually start with Ramp Coaching, job seekers with Break into SDR, and founders or leaders with Consulting.', open: false },
];

// Expose the FAQ to search and AI answer engines as machine-readable Q&A.
jsonLd['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${SITE}/#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vandana Agarwal Nik | Global SDR Coach</title>
  <meta name="description" content="Vandana Agarwal Nik is a Sales Development Leader and SDR coach. Break into SaaS, ramp faster, book meetings consistently, and build predictable pipeline. Book a session on Topmate." />
  <link rel="canonical" href="https://vandanaagarwal.in/" />
  <meta property="og:title" content="Vandana Agarwal Nik | Global SDR Coach" />
  <meta property="og:description" content="Become the SDR who books meetings, consistently. Break into SaaS, ramp fast, and hit your number, with coaching from a global SDR leader." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://vandanaagarwal.in/" />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:alt" content="Vandana Agarwal Nik, Global SDR Coach" />
  <meta property="og:site_name" content="Vandana Agarwal Nik" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Vandana Agarwal Nik | Global SDR Coach" />
  <meta name="twitter:description" content="Become the SDR who books meetings, consistently. Break into SaaS, ramp fast, and hit your number, with coaching from a global SDR leader." />
  <meta name="twitter:image" content={OG_IMAGE} />
  <meta name="author" content="Vandana Agarwal Nik" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta name="theme-color" content="#181818" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

<div class="preloader" id="preloader" aria-hidden="true">
  <div class="pl-spin"></div>
  <div class="pl-label">Loading</div>
</div>
<div class="aurora" aria-hidden="true">
  <span class="rb r1"></span>
  <span class="rb r2"></span>
  <span class="rb r3"></span>
  <span class="rb r4"></span>
</div>
<div class="grain" aria-hidden="true"></div>
<div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
<div class="scroll-prog" id="scrollProg" aria-hidden="true"></div>
<a href="#who" class="skip-link">Skip to content</a>

<header class="nav" id="siteNav">
  <div class="wrap nav-inner">
    <a href="#top" class="logo">
      <img src="/assets/va-headshot.jpg" alt="" width="36" height="36" aria-hidden="true" />
      <span>Vandana Agarwal Nik</span>
    </a>
    <nav class="nav-links" id="navLinks" aria-label="Primary">
      <a href="#who">Who I help</a>
      <a href="#intro">Meet me</a>
      <a href="#offers">Services</a>
      <a href="#reviews">Reviews</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a href={TOPMATE} target="_blank" rel="noopener" class="btn btn-primary nav-cta magnetic">Book on Topmate</a>
    <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
      <span></span>
    </button>
  </div>
</header>

<a id="top"></a>

<!-- HERO (Anima style: dark, centered, purple glow; pain-led copy) -->
<section class="hero">
  <span class="hero-glow" aria-hidden="true"></span>
  <span class="hero-glow g2" aria-hidden="true"></span>
  <div class="wrap hero-inner">
    <span class="kicker reveal">Global SDR coaching</span>
    <h1 class="reveal-text">Become the SDR who books meetings, <em>consistently.</em></h1>
    <p class="sub reveal" data-d="2"><b>Break into SaaS</b>, ramp fast, and hit your number month after month. I coach SDRs to turn outreach into booked meetings, and founders to build predictable pipeline.</p>
    <div class="hero-cta reveal" data-d="3">
      <a href={TOPMATE} target="_blank" rel="noopener" class="btn btn-primary magnetic">Book a session on Topmate</a>
      <a href="#who" class="btn btn-ghost-l magnetic">See how I can help</a>
    </div>
    <div class="chips reveal" data-d="3">
      <div class="chip"><b>8+ yrs</b><small>SaaS sales development</small></div>
      <div class="chip"><b>APAC &middot; EMEA &middot; AMER</b><small>Cross-border leadership</small></div>
      <div class="chip"><b>100 Powerful Women in Sales</b><small>Demandbase &amp; Women in Sales, 2025</small></div>
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true"><span class="mouse"></span><span>Scroll</span></div>
</section>

<!-- MARQUEE RIBBON -->
<div class="marquee" aria-hidden="true">
  <div class="marquee-track" id="marqueeTrack">
    <span><b>Ramp faster</b></span><span>Book more meetings</span><span><b>Break into SaaS</b></span><span>Predictable pipeline</span><span><b>SDR Leaders of APAC</b></span><span>AI-forward coaching</span><span><b>APAC · EMEA · AMER</b></span><span>Interview-ready</span>
    <span><b>Ramp faster</b></span><span>Book more meetings</span><span><b>Break into SaaS</b></span><span>Predictable pipeline</span><span><b>SDR Leaders of APAC</b></span><span>AI-forward coaching</span><span><b>APAC · EMEA · AMER</b></span><span>Interview-ready</span>
  </div>
</div>

<!-- WHO I HELP (the pain points, first) -->
<section id="who">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker">Sound familiar?</span>
      <h2>Wherever you're stuck in the SDR journey</h2>
      <p>Find yourself below, then pick the path that fits. If you are not sure, we figure it out together.</p>
    </div>
    <div class="aud-grid">
      {audiences.map((a, i) => (
        <div class="aud reveal" style={`--i:${i}`}>
          <span class="aud-ico" aria-hidden="true" set:html={ICONS[a.icon]}></span>
          <h3>{a.title}</h3>
          <p class="pain">{a.pain}</p>
          <p>{a.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- HOW I HELP / MEET ME (intro: story + about merged, this is where "Hi, I'm Vandana" lives) -->
<section id="intro" class="alt">
  <div class="wrap intro">
    <div class="intro-photo reveal" data-rev="l">
      <img src="/assets/va-portrait.jpg" alt="Vandana Agarwal Nik, SDR coach and Sales Development Leader" width="1000" height="1250" class="img-reveal" />
    </div>
    <div class="intro-body reveal" data-rev="r" data-d="1">
      <span class="hello">Hi, I'm Vandana</span>
      <h2>The mentor I wish I'd had, now in your corner</h2>
      <p class="lead-q">Early in my career, I didn't have someone who had done the job and could show me the way. I figured out outbound the hard way, one rejection at a time. That is exactly why I coach now.</p>
      <p>I build and scale high-performing SDR teams across APAC, EMEA, and AMER, from an early-stage startup at Clickpost to growth and scale at Rubrik and JumpCloud. I am obsessed with coaching systems that turn effort into booked meetings.</p>
      <p class="ai-line">I am also AI-forward, coaching on the real tools reps win with today: Gong, Hyperbound, Orum, 6sense, and Salesforce. So you learn to win in an AI-shaped sales world, not around it.</p>
      <ul class="cred">
        <li>Founder, <a href={APAC} target="_blank" rel="noopener">SDR Leaders of APAC</a> (250+ members)</li>
        <li>100 Powerful Women in Sales, 2025</li>
        <li>GrowthX Fellow</li>
        <li>8+ years in SaaS sales development</li>
      </ul>
      <div class="intro-cta">
        <a href={TOPMATE} target="_blank" rel="noopener" class="btn btn-primary">Book on Topmate</a>
        <a href={`mailto:${EMAIL}`} class="btn btn-ghost">Email me</a>
      </div>
    </div>
  </div>
</section>

<!-- RESULTS BAND (success stories) -->
<section class="results-band">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker" style="color: var(--lav)">A few things we've done together</span>
      <h2>Numbers that moved</h2>
    </div>
    <ul class="results">
      {results.map((r, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <b>{r.stat}</b>
          <small>{r.label}</small>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- PHOTO BANNER -->
<section class="banner-strip" aria-label="Helping SDRs perform better and prepare smarter for interviews">
  <img src="/assets/banner.jpg" alt="Vandana Agarwal Nik. Helping SDRs perform better and prepare smarter for interviews. Career clarity, growth mentorship, interview preparation, and coaching." width="1400" height="350" loading="lazy" />
</section>

<!-- WAYS TO WORK WITH ME / SERVICES (the offer) -->
<section id="offers">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker">Ways to work with me</span>
      <h2>Pick what feels right for you</h2>
      <p>Single sessions, longer programs, or a quick async review. Everything is booked on Topmate, where you can see times and details.</p>
    </div>

    <div class="tabs reveal" role="tablist" aria-label="Ways to work together">
      {groups.map((g, i) => (
        <button class={`tab${i === 0 ? ' active' : ''}`} role="tab" data-tab={g} aria-selected={i === 0 ? 'true' : 'false'}>
          {g}
        </button>
      ))}
    </div>

    {groups.map((g, i) => (
      <div class={`svc-panel${i === 0 ? ' active' : ''}`} data-panel={g}>
        <div class="svc-grid">
          {services[g].map((s, si) => (
            <a href={`${TOPMATE}/${s.id}`} target="_blank" rel="noopener" class={`svc reveal${s.wide ? ' svc-wide' : ''}`} style={`--i:${si}`}>
              <div class="svc-top">
                <span class="svc-format">{s.format} &middot; {s.dur}</span>
                {s.badge && <span class="badge">{s.badge}</span>}
              </div>
              <h3>{s.title}</h3>
              <p class="d">{s.desc}</p>
              <span class="svc-link">Book on Topmate <span aria-hidden="true">&rarr;</span></span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- TESTIMONIALS / SUCCESS STORIES -->
<section id="reviews" class="alt">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker">Kind words &bull; 5/5 on Topmate</span>
      <h2>What people say after a session</h2>
    </div>
    <div class="quotes">
      {testimonials.map((t, i) => (
        <figure class="quote reveal" style={`--i:${i % 3}`}>
          <div class="stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <blockquote>{t.quote}</blockquote>
          <div class="quote-by">
            <span class="avatar" aria-hidden="true">{t.initials}</span>
            <span class="quote-meta">
              <span class="who">{t.who}</span>
              <span class="verified">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/></svg>
                Verified on Topmate
              </span>
            </span>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- PROCESS (how we work together: after testimonials, before FAQ) -->
<section id="process">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker">How we work together</span>
      <h2>A simple system that removes the guesswork</h2>
    </div>
    <div class="steps">
      {steps.map((s, i) => (
        <div class="step reveal" style={`--i:${i}`}>
          <span class="n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FEATURED -->
<section id="featured">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker">Video podcasts</span>
      <h2>Catch me on the mic</h2>
    </div>
    <div class="videos">
      {videos.map((v, i) => (
        <div class="vid reveal" style={`--i:${i}`}>
          <div class="vframe">
            <iframe
              src={`https://www.youtube.com/embed/${v.id}`}
              title={`Video podcast ${i + 1}: ${v.caption}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <p>{v.caption}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="alt faq-sec">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="kicker">FAQ</span>
      <h2>Good questions before we start</h2>
    </div>
    {faqs.map((f) => (
      <details open={f.open} class="reveal">
        <summary>{f.q}</summary>
        <div class="a">{f.a}</div>
      </details>
    ))}
  </div>
</section>

<!-- FINAL CTA BANNER -->
<section class="final-band">
  <span class="hero-glow" aria-hidden="true"></span>
  <div class="wrap">
    <div class="final reveal">
      <span class="kicker">In your corner</span>
      <h2>Ready to move from busy to booked?</h2>
      <p>Let's make your pipeline predictable, one week at a time. I would love to help, whenever you are ready.</p>
      <div class="final-cta">
        <a href={TOPMATE} target="_blank" rel="noopener" class="btn btn-primary magnetic">Book on Topmate</a>
        <a href={LINKEDIN} target="_blank" rel="noopener" class="btn btn-ghost-l">Connect on LinkedIn</a>
      </div>
      <p class="final-mail">Not ready to book? Connect on LinkedIn, or just say hello at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="site">
  <div class="wrap foot">
    <span class="foot-logo">Vandana Agarwal Nik</span>
    <nav class="foot-nav" aria-label="Footer">
      <a href="#who">Who I help</a>
      <a href="#intro">Meet me</a>
      <a href="#offers">Services</a>
      <a href="#faq">FAQ</a>
      <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
      <a href={APAC} target="_blank" rel="noopener">SDR Leaders of APAC</a>
    </nav>
    <span>&copy; 2026 &middot; vandanaagarwal.in</span>
  </div>
</footer>

<script>
  // Mobile menu
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');
  if (toggle && links) {
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    links.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      });
    });
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  // Sticky nav scroll state + scroll progress bar
  const nav = document.getElementById('siteNav');
  const prog = document.getElementById('scrollProg');

  // Masked word reveal for headings (isolated in try/catch — DOM surgery must never break the page)
  try {
    document.querySelectorAll('.sec-head h2, .intro-body h2, .final h2').forEach((h) => h.classList.add('reveal-text'));
    document.querySelectorAll('.reveal-text').forEach((el) => {
      const out = [];
      el.childNodes.forEach((node) => {
        if (node.nodeType === 3) {
          node.textContent.split(/(\s+)/).forEach((tok) => {
            if (tok.trim() === '') { out.push(document.createTextNode(tok)); return; }
            const line = document.createElement('span'); line.className = 'w-line';
            const w = document.createElement('span'); w.className = 'w'; w.textContent = tok;
            line.appendChild(w); out.push(line);
          });
        } else {
          const line = document.createElement('span'); line.className = 'w-line';
          node.classList && node.classList.add('w');
          line.appendChild(node); out.push(line);
        }
      });
      el.textContent = '';
      out.forEach((n) => el.appendChild(n));
      el.querySelectorAll('.w').forEach((w, i) => { w.style.transitionDelay = (i * 0.055) + 's'; });
    });
  } catch (e) { /* headings just won't get the masked effect */ }

  // Reveal via IntersectionObserver (reliable, fires once per element)
  const revealAll = () => document.querySelectorAll('.reveal, .reveal-text, .img-reveal').forEach((el) => el.classList.add('in'));
  let io = null;
  const startReveals = () => {
    // Run for everyone — even under reduce-motion the CSS keeps a gentle opacity fade (no movement).
    if (!('IntersectionObserver' in window)) { revealAll(); return; }
    io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('.reveal, .reveal-text, .img-reveal').forEach((el) => io.observe(el));
  };

  // Sticky nav + scroll progress
  let ticking = false;
  const onScroll = () => {
    const y = window.scrollY;
    if (nav) nav.classList.toggle('scrolled', y > 12);
    if (prog) {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      prog.style.width = (h > 0 ? (y / h) * 100 : 0) + '%';
    }
    ticking = false;
  };
  const requestScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } };
  onScroll();
  window.addEventListener('scroll', requestScroll, { passive: true });

  // Subtle pointer tilt on cards (restrained, premium)
  if (!reduceMotion && finePointer) {
    document.querySelectorAll('.aud, .svc, .step, .quote, .vid').forEach((card) => {
      card.classList.add('tilt');
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `perspective(900px) rotateX(${py * -2.5}deg) rotateY(${px * 3}deg) translateY(-5px)`;
        // feed the cursor-follow spotlight glow
        card.style.setProperty('--mx', ((px + 0.5) * 100) + '%');
        card.style.setProperty('--my', ((py + 0.5) * 100) + '%');
      });
      card.addEventListener('pointerleave', () => { card.style.transform = ''; });
    });
  }

  // Magnetic buttons (cursor pull)
  if (!reduceMotion && finePointer) {
    document.querySelectorAll('.magnetic').forEach((btn) => {
      btn.addEventListener('pointermove', (e) => {
        const r = btn.getBoundingClientRect();
        const mx = e.clientX - r.left - r.width / 2;
        const my = e.clientY - r.top - r.height / 2;
        btn.style.transform = `translate(${mx * 0.28}px, ${my * 0.4}px)`;
      });
      btn.addEventListener('pointerleave', () => { btn.style.transform = ''; });
    });
  }

  // Custom cursor (desktop, lerped follow + grow on interactive hover)
  const cursor = document.getElementById('cursorDot');
  if (cursor && !reduceMotion && finePointer) {
    document.body.classList.add('has-cursor');
    let cx = window.innerWidth / 2, cy = window.innerHeight / 2, tx = cx, ty = cy;
    window.addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; }, { passive: true });
    const cloop = () => { cx += (tx - cx) * 0.22; cy += (ty - cy) * 0.22; cursor.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`; requestAnimationFrame(cloop); };
    cloop();
    document.querySelectorAll('a, button, .svc, .aud, .quote, .vid, .chip, details summary').forEach((el) => {
      el.addEventListener('pointerenter', () => cursor.classList.add('big'));
      el.addEventListener('pointerleave', () => cursor.classList.remove('big'));
    });
  }

  // Preloader — simple "loading", fades out fast, then content reveals
  const pre = document.getElementById('preloader');
  let revealsStarted = false;
  const begin = () => { if (revealsStarted) return; revealsStarted = true; startReveals(); };
  const finish = () => { if (pre) pre.classList.add('done'); document.body.style.overflow = ''; begin(); };
  if (pre && !reduceMotion) {
    document.body.style.overflow = 'hidden';
    let done = false;
    const go = () => { if (done) return; done = true; finish(); };
    // Finish shortly after the page is ready, capped so it can never feel stuck.
    if (document.readyState === 'complete') { setTimeout(go, 200); }
    else { window.addEventListener('load', () => setTimeout(go, 200)); }
    setTimeout(go, 900); // hard cap
  } else {
    finish();
  }

  // Service tabs — re-fire the 3D card cascade on every switch (lots of motion in the booking area)
  const cascade = (panel) => {
    const cards = panel.querySelectorAll('.svc');
    cards.forEach((c) => c.classList.remove('in'));
    void panel.offsetWidth; // force reflow so the animation restarts
    cards.forEach((c) => c.classList.add('in'));
  };
  document.querySelectorAll('.tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-tab');
      document.querySelectorAll('.tab').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
      });
      document.querySelectorAll('.svc-panel').forEach((p) => {
        const on = p.getAttribute('data-panel') === key;
        p.classList.toggle('active', on);
        if (on && !reduceMotion) cascade(p);
      });
    });
  });

  // Native scroll only — no external smooth-scroll library (faster, fully offline, nothing to hang on).
  // In-page anchor smoothness is handled by CSS `html { scroll-behavior: smooth }`.
</script>

<!-- Failsafe: a separate script so a thrown error above can never leave the page hidden -->
<script>
  setTimeout(function () {
    var p = document.getElementById('preloader');
    if (p) p.classList.add('done');
    document.body.style.overflow = '';
    document.querySelectorAll('.reveal, .reveal-text, .img-reveal').forEach(function (el) { el.classList.add('in'); });
  }, 2200);
</script>

</body>
</html>
