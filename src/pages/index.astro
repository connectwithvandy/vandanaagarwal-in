---
import WorkLayout from '../layouts/WorkLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBand from '../components/ContactBand.astro';
import { EMAIL, socials, proof, groups, whatIDo, highlights, about, services, recs, RECS_URL, coaching, TOPMATE, posts, SUBSTACK } from '../data/work.js';

const linkedin = socials.find((s) => s.label === 'LinkedIn').href;
const all = groups.flatMap((g) => g.projects);
const tedCard = {
  name: 'Ted',
  line: 'a health buddy that lives in WhatsApp',
  tags: ['After hours', '100 users', 'Live'],
  body: 'A health buddy on WhatsApp. Tell it what you ate and how you moved, and it gives you one useful thing you can still do today. Built alone, at night.',
  link: { href: 'https://heyted.in', label: 'Meet Ted' },
};
const picks = highlights.map((n) => (n === 'Ted' ? tedCard : all.find((p) => p.name === n)));
---
<WorkLayout
  title="Vandana Agarwal Nik | GTM leader who builds"
  description="Eight years building SDR teams across APAC, EMEA and the US. By night, I build AI tools for sales teams, and Ted, a WhatsApp health buddy 100 people have used."
>
  <section class="w-hero">
    <span class="hero-glow" aria-hidden="true"></span>
    <div class="wrap">
      <img class="w-face" src="/assets/va-headshot.jpg" alt="Vandana Agarwal Nik" width="96" height="96" />
      <span class="kicker">GTM leader · Bengaluru</span>
      <h1>By day I led 10 SDRs.<br /><em>By night I built the tools they needed.</em></h1>
      <p class="sub">
        Eight years building SDR teams across APAC, EMEA and the US, at JumpCloud, Rubrik,
        Branch and ClickPost. I am not an engineer. I build with Claude, around problems I have lived.
      </p>
      <span class="w-status">Open to AE and GTM roles, ideally at AI native companies</span>
      <div class="w-cta">
        <a href={`mailto:${EMAIL}`} class="btn btn-primary">Email me</a>
        <a href={linkedin} target="_blank" rel="noopener" class="btn btn-ghost-l">LinkedIn</a>
      </div>
      <div class="chips">
        {proof.map((p) => (<div class="chip"><b>{p.big}</b><small>{p.small}</small></div>))}
      </div>
    </div>
  </section>

  <section class="w-sec" id="what-i-do">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">What I do</span>
        <h2>Three things I am good at</h2>
      </div>
      <div class="w-grid">
        {whatIDo.map((w) => (
          <div class="w-card">
            <h3>{w.head}</h3>
            <p style="margin-top:10px">{w.body}</p>
            <p class="result">{w.proof}</p>
          </div>
        ))}
      </div>
      <a class="go more" href="/experience">See my experience →</a>
    </div>
  </section>

  <section class="w-sec" id="selected">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Selected work</span>
        <h2>Things I built</h2>
        <p>One for my team, one from a buildathon, one after hours.</p>
      </div>
      <ol class="w-grid">{picks.map((p) => <ProjectCard p={p} />)}</ol>
      <a class="go more" href="/built">See all {all.length + 1} projects →</a>
    </div>
  </section>

  <section class="w-sec" id="recommendations">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Recommendations</span>
        <h2>What people say</h2>
        <p>From managers, peers and people who reported to me. In their own words, on LinkedIn.</p>
      </div>
      <div class="w-grid">
        {recs.map((r) => (
          <figure class="w-card rec">
            <blockquote>“{r.quote}”</blockquote>
            <figcaption><b>{r.who}</b><span>{r.role}</span></figcaption>
          </figure>
        ))}
      </div>
      <a class="go more" href={RECS_URL} target="_blank" rel="noopener">Read all 15 on LinkedIn ↗</a>
    </div>
  </section>

  <section class="w-sec" id="about">
    <div class="wrap about">
      <div>
        <span class="kicker">About me</span>
        <h2 class="about-h">Outside the <em>numbers</em></h2>
        {about.paras.map((t) => <p>{t}</p>)}
      </div>
      <div class="about-side">
        <img src="/assets/va-portrait.jpg" alt="Vandana Agarwal Nik" width="1000" height="1250" loading="lazy" />
        <div class="facts">
          {about.chips.map((c) => (<div><b>{c.big}</b><small>{c.small}</small></div>))}
        </div>
      </div>
    </div>
  </section>

  <section class="w-sec" id="work-with-me">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Work with me</span>
        <h2>Roles I am looking for</h2>
        <p>I am open to a few kinds of roles. Here is what I would bring to each.</p>
      </div>
      <div class="w-grid two">
        {services.map((s, i) => (
          <div class="w-card svc-card">
            <span class="num">0{i + 1}</span>
            <h3>{s.head}</h3>
            <p style="margin-top:10px">{s.body}</p>
            <ul class="svc-proof">{s.proof.map((x) => <li>{x}</li>)}</ul>
            <a class="go" href={`mailto:${EMAIL}?subject=${encodeURIComponent(s.subject)}`}>Email me about this →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="w-sec" id="coaching">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Coaching</span>
        <h2>For SDRs and founders</h2>
        <p>I coach SDRs one on one, and help founders set up their SDR function. Booked through Topmate.</p>
      </div>
      <div class="w-grid two">
        {coaching.map((c) => (
          <a class="w-card offer" href={`${TOPMATE}/${c.id}`} target="_blank" rel="noopener">
            <span class="dur">{c.dur}</span>
            <h3>{c.title}</h3>
            <p>{c.who}</p>
          </a>
        ))}
      </div>
      <div class="w-cta" style="justify-content:flex-start">
        <a href={TOPMATE} target="_blank" rel="noopener" class="btn btn-primary">Book on Topmate</a>
        <a href="/coaching" class="btn btn-ghost-l">More about coaching</a>
      </div>
    </div>
  </section>

  <section class="w-sec" id="writing">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Writing</span>
        <h2>The SDR Field Guide</h2>
        <p>A free series on Substack about selling in APAC: ICP, cadence, channels, objections.</p>
      </div>
      <ol class="post-list">
        {posts.map((p) => (
          <li><a href={`${SUBSTACK}/p/${p.slug}`} target="_blank" rel="noopener">{p.title} ↗</a></li>
        ))}
      </ol>
      <div class="w-cta" style="justify-content:flex-start">
        <a href="/resources" class="btn btn-ghost-l">All resources</a>
        <a href={SUBSTACK} target="_blank" rel="noopener" class="btn btn-ghost-l">Subscribe on Substack</a>
      </div>
    </div>
  </section>

  <ContactBand />
</WorkLayout>
