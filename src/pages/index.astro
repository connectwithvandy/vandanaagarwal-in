---
import WorkLayout from '../layouts/WorkLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBand from '../components/ContactBand.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { EMAIL, CV, videos, proof, groups, highlights, about, services, recs, RECS_URL, SUBSTACK } from '../data/work.js';

const all = groups.flatMap((g) => g.projects);
const tedCard = {
  name: 'Ted',
  line: 'a health buddy that lives in WhatsApp',
  tags: ['After hours', '100 users', 'Live'],
  body: 'Tell it what you ate and how you moved. It gives you one useful thing you can still do today.',
  link: { href: 'https://heyted.in', label: 'Meet Ted' },
};
const picks = highlights.map((n) => (n === 'Ted' ? tedCard : all.find((p) => p.name === n)));
---
<WorkLayout
  title="Vandana Agarwal Nik | GTM leader who builds"
  description="Eight years building SDR teams across APAC, EMEA and the US. By night, I build AI tools for sales teams, and Ted, a WhatsApp health buddy 100 people have used."
>
  <section class="w-hero">
    <span class="hero-glow" aria-hidden="true"></span>
    <div class="wrap">
      <img class="w-face" src="/assets/va-headshot.jpg" alt="Vandana Agarwal Nik" width="96" height="96" />
      <span class="kicker">GTM leader · Bengaluru</span>
      <h1>Your pipeline runs on people and process.<br /><em>I build both.</em></h1>
      <p class="sub">
        Eight years building SDR teams at JumpCloud, Rubrik, Branch and ClickPost. I build the tools they need with Claude.
      </p>
      <span class="w-status">Hiring for sales or GTM? Let's talk.</span>
      <div class="w-cta">
        <a href={`mailto:${EMAIL}`} class="btn btn-primary">Email me</a>
        <a href={CV} download class="btn btn-ghost-l">Download CV</a>
      </div>
      <SocialIcons />
      <div class="chips">
        {proof.map((p) => (<div class="chip"><b>{p.big}</b><small>{p.small}</small></div>))}
      </div>
    </div>
  </section>

  <section class="w-sec" id="work-with-me">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">What I do</span>
        <h2>Roles I'm built for</h2>
      </div>
      <div class="w-grid two">
        {services.map((s) => (
          <div class="w-card svc-card">
            <h3>{s.head}</h3>
            <p style="margin-top:10px">{s.body}</p>
            <a class="go" href={`mailto:${EMAIL}?subject=${encodeURIComponent(s.subject)}`}>Email me about this →</a>
          </div>
        ))}
      </div>
      <a class="go more" href="/experience">See my experience →</a>
    </div>
  </section>

  <section class="w-sec" id="recommendations">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Recommendations</span>
        <h2>What people say</h2>
      </div>
      <div class="w-grid">
        {recs.slice(0, 3).map((r) => (
          <figure class="w-card rec">
            <blockquote>“{r.quote}”</blockquote>
            <figcaption><b>{r.who}</b><span>{r.role}</span></figcaption>
          </figure>
        ))}
      </div>
      <a class="go more" href={RECS_URL} target="_blank" rel="noopener">Read all 15 on LinkedIn ↗</a>
    </div>
  </section>

  <section class="w-sec" id="selected">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Selected work</span>
        <h2>Things I built</h2>
        <p>One for my team, one from a buildathon, one after hours.</p>
      </div>
      <ol class="w-grid">{picks.map((p) => <ProjectCard p={p} />)}</ol>
      <a class="go more" href="/built">See all {all.length + 1} projects →</a>
    </div>
  </section>

  <section class="w-sec" id="about">
    <div class="wrap about">
      <div>
        <span class="kicker">About me</span>
        <h2 class="about-h">Outside the <em>numbers</em></h2>
        {about.paras.map((t) => <p>{t}</p>)}
      </div>
      <div class="about-side">
        <img src="/assets/va-portrait.jpg" alt="Vandana Agarwal Nik" width="1000" height="1250" loading="lazy" />
        <div class="facts">
          {about.chips.map((c) => (<div><b>{c.big}</b><small>{c.small}</small></div>))}
        </div>
      </div>
    </div>
  </section>

  <section class="w-sec" id="elsewhere">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Elsewhere</span>
        <h2>Coaching and writing</h2>
      </div>
      <div class="w-grid two">
        <a class="w-card offer" href="/coaching">
          <h3>Coaching</h3>
          <p>One on one for SDRs, and SDR setup for founders.</p>
          <span class="go">See coaching →</span>
        </a>
        <a class="w-card offer" href={SUBSTACK} target="_blank" rel="noopener">
          <h3>The SDR Field Guide</h3>
          <p>A free Substack series on selling in APAC.</p>
          <span class="go">Read on Substack ↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="w-sec heard" id="videos">
    <div class="wrap">
      <span class="kicker">As heard on</span>
      <div class="heard-row">
        {videos.map((v) => (
          <a class="heard-item" href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener">
            <span class="vid-thumb"><img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" /><span class="vid-play" aria-hidden="true">▶</span></span>
            <span class="heard-cap">{v.caption}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactBand />
</WorkLayout>
