---
// Row of link icons under the hero: the ways to find Vandy, visible without scrolling.
import { EMAIL } from '../data/work.js';
const items = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/meet-vandana/', d: 'M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.5 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v7.44h-4.56v-6.6c0-1.57-.03-3.6-2.19-3.6-2.2 0-2.53 1.71-2.53 3.48V22H7.72V8z' },
  { label: 'X', href: 'https://x.com/vandism_ag', d: 'M18.24 2H21.6l-7.34 8.39L22.9 22h-6.77l-5.3-6.93L4.76 22H1.4l7.85-8.97L1 2h6.94l4.79 6.33L18.24 2zm-1.18 18h1.86L7.02 3.9H5.02L17.06 20z' },
  { label: 'GitHub', href: 'https://github.com/connectwithvandy', d: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z' },
  { label: 'Substack', href: 'https://coachingbyvandy.substack.com', d: 'M22.54 8.25H1.46V5.4h21.08v2.85zM1.46 10.8V24L12 18.11 22.54 24V10.8H1.46zM22.54 0H1.46v2.84h21.08V0z' },
  { label: 'Email', href: `mailto:${EMAIL}`, d: 'M2 4h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm10 8.4L2.4 6H2v.6l10 6.7 10-6.7V6h-.4L12 12.4z' },
];
---
<div class="socials">
  {items.map((i) => (
    <a href={i.href} target={i.href.startsWith('http') ? '_blank' : undefined} rel="noopener" aria-label={i.label} title={i.label}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={i.d} /></svg>
    </a>
  ))}
</div>

<style>
  .socials { display: flex; justify-content: center; gap: 10px; margin: -12px 0 30px; }
  .socials a { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; color: var(--soft); background: rgba(255,255,255,.04); border: 1px solid var(--line); transition: color .2s, border-color .2s; }
  .socials a:hover { color: #fff; border-color: var(--violet-2); }
</style>
